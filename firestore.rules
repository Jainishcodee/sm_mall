rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Helper functions ───

    function isAuthenticated() {
      return request.auth != null;
    }

    // Phone-derived identity. The OTP flow writes the phone key
    // (digits-only E.164, e.g. "919876543210") to FirebaseAuth.User.displayName,
    // which Firebase exposes here as `request.auth.token.name`.
    function currentPhoneKey() {
      return request.auth.token.name;
    }

    function isUserOwner(phoneKey) {
      return isAuthenticated() && currentPhoneKey() == phoneKey;
    }

    // Admin check: reads /users/{currentPhoneKey()}.isAdmin.
    function isAdmin() {
      return isAuthenticated() &&
             currentPhoneKey() != null &&
             get(/databases/$(database)/documents/users/$(currentPhoneKey())).data.isAdmin == true;
    }

    // ─── Categories ───
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ─── Products ───
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() &&
                       request.resource.data.name is string &&
                       request.resource.data.category is string &&
                       request.resource.data.price is number &&
                       request.resource.data.unit is string &&
                       request.resource.data.storeId is string;
      allow update: if isAdmin() &&
                       request.resource.data.name is string &&
                       request.resource.data.category is string &&
                       request.resource.data.price is number &&
                       request.resource.data.unit is string;
      allow delete: if isAdmin();
    }

    // ─── Users ─── (keyed by phone, NOT by Firebase Auth uid)
    match /users/{phoneKey} {
      allow read: if isUserOwner(phoneKey) || isAdmin();
      allow create: if isUserOwner(phoneKey);
      // Owner can edit their own profile, but cannot self-promote to admin.
      allow update: if isUserOwner(phoneKey) &&
                       (!('isAdmin' in request.resource.data) ||
                        request.resource.data.isAdmin == resource.data.isAdmin);
      allow delete: if isAdmin();

      // User Addresses Subcollection
      match /addresses/{addressId} {
        allow read: if isUserOwner(phoneKey) || isAdmin();
        allow create: if isUserOwner(phoneKey) &&
                         request.resource.data.address is string &&
                         request.resource.data.label is string;
        allow update: if isUserOwner(phoneKey);
        allow delete: if isUserOwner(phoneKey) || isAdmin();
      }
    }

    // ─── Orders ─── (userId field stores the phone key)
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
                     (isAdmin() || resource.data.userId == currentPhoneKey());

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == currentPhoneKey() &&
                       request.resource.data.total is number &&
                       request.resource.data.status is string &&
                       request.resource.data.items is list;

      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read: if isAuthenticated() &&
                       (isAdmin() ||
                        get(/databases/$(database)/documents/orders/$(orderId)).data.userId == currentPhoneKey());
        allow write: if isAdmin();
      }
    }

    // ─── Payments ─── (userId field stores the phone key)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() &&
                     (isAdmin() || resource.data.userId == currentPhoneKey());

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == currentPhoneKey() &&
                       request.resource.data.amount is number &&
                       request.resource.data.orderId is string &&
                       request.resource.data.status is string;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── App Settings ───
    match /app_settings/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
